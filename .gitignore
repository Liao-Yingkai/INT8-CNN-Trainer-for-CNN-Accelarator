# Downloaded VOC data and YOLO training checkpoints
YOLOV2_TINY/data/
YOLOV2_TINY/checkpoints/*
!YOLOV2_TINY/checkpoints/.gitkeep

# Generated FPGA parameter exports (NPY/JSON/BIN/headers belong here)
MNIST/generated/*
!MNIST/generated/.gitkeep
YOLOV2_TINY/generated/*
!YOLOV2_TINY/generated/.gitkeep

