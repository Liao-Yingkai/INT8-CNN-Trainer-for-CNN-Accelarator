.coverage
htmlcov/

# Downloaded MNIST data and training checkpoints
MNIST/data/
MNIST/checkpoints/*
!MNIST/checkpoints/.gitkeep
*.pth
*.pt
*.ckpt
*.weights
*.onnx
*.tflite
*.safetensors
*.bin
