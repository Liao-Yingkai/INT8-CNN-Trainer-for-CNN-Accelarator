*.py[cod]
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
.vscode/
.idea/
.DS_Store
*.swp
*.swo
*~
/build/
/dist/
/artifacts/
/runs/
